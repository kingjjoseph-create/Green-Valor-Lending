# Green Valor Lending: environment variables
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.
# Leave a value blank if it is not confirmed; the site hides anything that is blank.

# Site
NEXT_PUBLIC_SITE_URL=
# Keep false until launch sign-off (robots.txt blocks all crawlers while false)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact (not yet provided by the business)
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_RECRUITING_EMAIL=
# Shown on /contact only when supplied, e.g. "Monday to Friday, 9:00 a.m. to 5:00 p.m. ET"
NEXT_PUBLIC_BUSINESS_HOURS=
# Office address: shown only when PUBLISH is true AND street, city, state and ZIP are set. Never use a placeholder.
NEXT_PUBLIC_PUBLISH_OFFICE_ADDRESS=false
NEXT_PUBLIC_OFFICE_STREET=
NEXT_PUBLIC_OFFICE_SUITE=
NEXT_PUBLIC_OFFICE_CITY=
NEXT_PUBLIC_OFFICE_STATE=
NEXT_PUBLIC_OFFICE_POSTAL_CODE=

# Licensing (company NMLS ID is pending; leave blank until issued)
NEXT_PUBLIC_COMPANY_NMLS_ID=
NEXT_PUBLIC_FL_LICENSE_NUMBER=

# Borrower application and scheduling
# Approved ARIVE borrower portal (https only). When blank, the Get Started confirmation shows no application button.
NEXT_PUBLIC_BORROWER_APPLICATION_URL=
NEXT_PUBLIC_SCHEDULING_URL=

# CRM (public identifiers only)
NEXT_PUBLIC_CRM_PROVIDER=
NEXT_PUBLIC_CRM_FORM_ID=
# Server-only CRM credentials (never prefix with NEXT_PUBLIC_)
CRM_API_KEY=

# General contact form (/contact -> /api/contact). Server-only: never prefix with NEXT_PUBLIC_.
# Configure at least one channel; with neither, the form says online messages are unavailable.
# Option 1: CRM webhook (JSON POST; records are type "contact_inquiry", category mortgage_inquiry or general_inquiry)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Option 2: email via Resend (uses RESEND_API_KEY below)
CONTACT_EMAIL_FROM=
# General inbox; falls back to NEXT_PUBLIC_COMPANY_EMAIL when blank
CONTACT_EMAIL_TO=
# Optional separate inbox for Residential and Non-QM inquiries
CONTACT_MORTGAGE_EMAIL_TO=
# Optional Cloudflare Turnstile spam challenge (both keys needed)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Get Started mortgage inquiries (/get-started -> /api/inquiry). Server-only.
# Records are type "mortgage_inquiry", category "borrower_lead", with a classification block.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
# Email notification via Resend (uses RESEND_API_KEY). FROM falls back to CONTACT_EMAIL_FROM;
# TO falls back to CONTACT_MORTGAGE_EMAIL_TO, then CONTACT_EMAIL_TO, then NEXT_PUBLIC_COMPANY_EMAIL.
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=

# Recruitment inquiries (/careers -> /api/recruitment). Server-only: never prefix with NEXT_PUBLIC_.
# Kept separate from borrower inquiries. Configure at least one channel; with neither,
# the form tells applicants online inquiries are unavailable (no false success).
# Option 1: webhook to a recruiting CRM / ATS / automation (JSON POST)
RECRUITMENT_WEBHOOK_URL=
# Optional: signs each request as X-Green-Valor-Signature: sha256=<HMAC of body>
RECRUITMENT_WEBHOOK_SECRET=
# Option 2: email via Resend (https://resend.com); the sending domain must be verified
RESEND_API_KEY=
RECRUITMENT_EMAIL_FROM=
# Recipient; falls back to NEXT_PUBLIC_RECRUITING_EMAIL when blank
RECRUITMENT_EMAIL_TO=

# Social media
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# Feature flags (true/false)
NEXT_PUBLIC_FEATURE_CALCULATORS=true
NEXT_PUBLIC_FEATURE_LEAD_FORMS=false
# Recruitment inquiry form on /careers (default true; set false to hide it)
NEXT_PUBLIC_FEATURE_CAREERS_APPLICATION=true

# Compliance: show Equal Housing Opportunity identification once wording/logo usage is approved
NEXT_PUBLIC_EQUAL_HOUSING_APPROVED=false
# Internal component gallery at /styleguide (preview deployments only; never production)
NEXT_PUBLIC_ENABLE_STYLEGUIDE=false
