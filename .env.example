# Green Valor Lending: environment variables
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.
# Leave a value blank if it is not confirmed; the site hides anything that is blank.

# Site
NEXT_PUBLIC_SITE_URL=
# Keep false until launch sign-off (robots.txt blocks all crawlers while false)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact (not yet provided by the business)
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_RECRUITING_EMAIL=

# Licensing (company NMLS ID is pending; leave blank until issued)
NEXT_PUBLIC_COMPANY_NMLS_ID=
NEXT_PUBLIC_FL_LICENSE_NUMBER=

# Borrower application and scheduling
NEXT_PUBLIC_BORROWER_APPLICATION_URL=
NEXT_PUBLIC_SCHEDULING_URL=

# CRM (public identifiers only)
NEXT_PUBLIC_CRM_PROVIDER=
NEXT_PUBLIC_CRM_FORM_ID=
# Server-only CRM credentials (never prefix with NEXT_PUBLIC_)
CRM_API_KEY=

# Social media
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# Feature flags (true/false)
NEXT_PUBLIC_FEATURE_CALCULATORS=false
NEXT_PUBLIC_FEATURE_LEAD_FORMS=false
NEXT_PUBLIC_FEATURE_CAREERS_APPLICATION=false
